# Codex2API（管理密钥只在服务端读取，绝不会返回给浏览器）
CODEX2API_BASE_URL=https://your-codex2api.example.com
CODEX2API_ADMIN_KEY=replace-with-admin-key

# 两个密码必须不同。生产环境请使用密码管理器生成长随机值。
POOL_MANAGER_ADMIN_PASSWORD=replace-with-strong-admin-password
POOL_MANAGER_SUPPLIER_PASSWORD=replace-with-strong-supplier-password

# 本地默认仅监听回环地址。容器中使用 0.0.0.0。
POOL_MANAGER_HOST=127.0.0.1
POOL_MANAGER_PORT=8790

# HTTPS 反向代理后必须改成 true。
POOL_MANAGER_SECURE_COOKIE=false
POOL_MANAGER_SESSION_HOURS=12
POOL_MANAGER_HTTP_TIMEOUT_SECONDS=30

# 可选持久化路径。文件不包含任何 Token 或 Codex2API 密钥。
# POOL_MANAGER_SETTINGS_FILE=./data/settings.json
# POOL_MANAGER_AUDIT_FILE=./data/audit.jsonl
